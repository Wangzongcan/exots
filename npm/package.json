{
  "name": "exots",
  "version": "0.2.0",
  "description": "High-performance IPC bridge for executing TypeScript/JavaScript functions from Ruby",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "prepack": "pnpm run build && cp ../LICENSE . && cp ../README.md .",
    "postpack": "rm LICENSE README.md",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ipc",
    "socket",
    "rpc"
  ],
  "author": "sunteya <sunteya@gmail.com>",
  "repository": "sunteya/exots",
  "homepage": "https://github.com/sunteya/exots",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "ISC",
  "dependencies": {
    "json-rpc-2.0": "^1.7.1",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  }
}
